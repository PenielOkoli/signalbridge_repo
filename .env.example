# ================================================================================
# CRITICAL: Secrets for Production Deployment
# ================================================================================

# Next.js server-side proxy -> backend API bridge.
# These are intentionally not NEXT_PUBLIC_* so users never see the bearer token.
SIGNALBRIDGE_API_URL=https://your-api-domain.example

# CRITICAL: Generate a new bearer token for each deployment using:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# CHANGE THIS VALUE - DO NOT USE THE EXAMPLE
SIGNALBRIDGE_API_TOKEN=CHANGE-ME-GENERATE-NEW-TOKEN

# Backend API bridge authentication - MUST MATCH the token above
# CHANGE THIS VALUE - DO NOT USE THE EXAMPLE
API_BEARER_TOKEN=CHANGE-ME-GENERATE-NEW-TOKEN

# CORS Origins - Restrict to your frontend domain(s) in production
CORS_ORIGINS=https://your-dashboard-domain.example

# Set this to production/live only on the deployed backend. Startup will refuse
# unsafe settings when it is enabled.
SIGNALBRIDGE_ENV=production

# Public hostname(s) served by the FastAPI reverse proxy, without a scheme.
TRUSTED_HOSTS=api.your-domain.example

# Enable this only when Caddy, Nginx, or the Google load balancer strips
# incoming X-Forwarded-For and writes the verified client IP itself.
SIGNALBRIDGE_TRUST_PROXY_HEADERS=true

# Dashboard user sessions.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SIGNALBRIDGE_AUTH_SECRET=CHANGE-ME-GENERATE-NEW-AUTH-SECRET
SIGNALBRIDGE_SESSION_TTL_SECONDS=604800
SIGNALBRIDGE_COOKIE_SECURE=true

# Password-recovery email (SMTP). Password-reset links expire after one hour
# and are single-use. SMTP_USERNAME is optional for a trusted relay.
SIGNALBRIDGE_APP_URL=https://your-dashboard-domain.example
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM=SignalBridge <no-reply@your-domain.example>
SMTP_USE_STARTTLS=true
# Set SMTP_USE_SSL=true instead for an implicit-TLS provider (usually port 465).

# Keep false in production unless you intentionally want public self-signup.
# The first account can always be created when users.json is empty.
ALLOW_PUBLIC_SIGNUP=false

# Backend-owned Telegram app credentials.
# Users only enter their phone number and login code in the dashboard.
SIGNALBRIDGE_TELEGRAM_API_ID=123456
SIGNALBRIDGE_TELEGRAM_API_HASH=replace-with-your-telegram-api-hash
SIGNALBRIDGE_TELEGRAM_SESSION_NAME=signalbridge

# Backend-owned parser key. Users should not configure this in the dashboard.
# Prefer SIGNALBRIDGE_PARSER_API_KEY so the app can switch providers without
# changing deployment secrets. OPENAI_API_KEY and GROQ_API_KEY also work.
SIGNALBRIDGE_PARSER_API_KEY=replace-with-your-provider-key

# Optional parser defaults controlled by the deployment operator.
# Keep these server-side; do not expose them as NEXT_PUBLIC_* values.
SIGNALBRIDGE_HOST=0.0.0.0
SIGNALBRIDGE_PORT=8000
SIGNALBRIDGE_LOG_LEVEL=info
